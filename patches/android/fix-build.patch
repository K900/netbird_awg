diff --git a/build-android-lib.sh b/build-android-lib.sh
index 046151c..b1c72ea 100755
--- a/build-android-lib.sh
+++ b/build-android-lib.sh
@@ -136,6 +136,31 @@ ensure_gomobile_tools
 
 # -androidapi must match minSdkVersion in build.gradle.kts. Without it gomobile
 # defaults to API 16, which only NDK r23 and older still accept.
+real_go=$(command -v go)
+awg_go_dir=
+if [[ -d "$app_path/../amneziawg-go" ]]; then
+  awg_go_dir="$(cd "$app_path/../amneziawg-go" && pwd)"
+fi
+go_wrapper_dir=$(mktemp -d)
+trap 'rm -rf "$go_wrapper_dir"' EXIT
+cat > "$go_wrapper_dir/go" <<EOF
+#!/bin/bash
+set -euo pipefail
+real_go="$real_go"
+awg_go_dir="$awg_go_dir"
+if [[ -f go.mod ]] && grep -q '^module gobind' go.mod; then
+  "\$real_go" mod edit -require=github.com/cloudflare/circl@v1.3.3
+  "\$real_go" mod edit -replace=github.com/cloudflare/circl=codeberg.org/cunicu/circl@v0.0.0-20230801113412-fec58fc7b5f6
+  if [[ -d "\$awg_go_dir" ]]; then
+    "\$real_go" mod edit -replace=github.com/amnezia-vpn/amneziawg-go/v3="\$awg_go_dir"
+  fi
+  "\$real_go" mod tidy
+fi
+exec "\$real_go" "\$@"
+EOF
+chmod +x "$go_wrapper_dir/go"
+
+PATH="$go_wrapper_dir:$PATH" \
 CGO_ENABLED=0 gomobile bind \
   -androidapi 26 \
   -o "$app_path/gomobile/netbird.aar" \
